# Secret-bearing files. Every pattern is anchored with a leading "/" so it
# can never swallow a chart template; the "/**/" form still matches at any
# depth (an unanchored "secrets.yaml" pattern once silently dropped
# templates/secrets.yaml from git in a sibling repo).
/.env
/**/.env
/**/*.env
!/.env.example

# Kubernetes secrets with real values
/**/01-secrets.yaml

# Development tooling
.claude/
.playwright-mcp/
.playwright-cli/
.vibe-attachments/
node_modules/

# OS files
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
*.swo
*~

# Python
__pycache__/
*.pyc
*.pyo
.venv/

# Logs
*.log

# Temporary files
/tmp/
